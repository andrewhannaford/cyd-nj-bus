# Stop IDs to poll and merge into one board. A physical stop pole usually
# has its own stop_id per direction - list both if you want both directions
# shown together. Find stop IDs from the stop number shown in NJ Transit's
# own rider app, or by searching mybusnow.njtransit.com by route/stop name.
STOP_IDS=00000

POLL_INTERVAL=30
PORT=8000

# NJT BUSDATA (BUSDV2) API credentials - see .env.njt (not committed;
# pulled from 1Password's "NJ Transit" item) for the real values.
NJT_USERNAME=
NJT_PASSWORD=
