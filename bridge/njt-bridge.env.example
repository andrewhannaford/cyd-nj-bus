NJT_USERNAME=your-njt-developer-username
NJT_PASSWORD=change-me

# Stop IDs to poll and merge into one board. A physical stop pole usually
# has its own stop_id per direction - list both if you want both directions
# shown together. Find stop IDs from the GTFS static feed's stops.txt
# (stop_code/stop_id column) once your developer account is approved, or
# from the stop number shown in NJ Transit's own rider app.
STOP_IDS=00000

POLL_INTERVAL=30
PORT=8000
